# Server-side PHP API mode (recommended)
# The desktop app calls this API for auth, data, scheduler, and updates.
APP_SERVER_API_BASE_URL=
APP_SERVER_API_TIMEOUT_MS=15000

# Optional (defaults are fine if omitted)
SHOPIFY_OAUTH_PORT=4319

# Optional: key used to encrypt Shopify OAuth client secrets at rest.
# Leave blank to use the built-in shared default (works across all installs).
# If you set a custom value, ALL desktop clients that share the same server
# data MUST use the exact same value, or saved secrets will fail to decrypt.
APP_ENCRYPTION_KEY=

# Server-side Shopify OAuth (Phase 1). When 'true' (and APP_SERVER_API_BASE_URL is set),
# the server holds the client secret and does the token exchange; the desktop only catches
# the localhost callback and 302-redirects it to the server. Keep 'false' until the settings
# UI saves OAuth apps server-side and the publish proxy is in place (see docs/shopify-oauth-server-side.md).
SHOPIFY_SERVER_OAUTH=false
# Must exactly match the redirect URL registered in the Shopify Partner app.
SHOPIFY_OAUTH_LOCAL_REDIRECT_URL=http://localhost:3000/api/auth/shopify/callback
