# MongoDB Atlas Configuration
# Get your connection string from https://cloud.mongodb.com

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aiblog_generator
MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
MONGODB_DNS_IPV4FIRST=true

# Example Connection Strings:

# MongoDB Atlas (Recommended - Free Tier Available)
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=aiblog_generator

# Local MongoDB (for development)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=aiblog_generator

# MongoDB with authentication
# MONGODB_URI=mongodb://username:password@localhost:27017
# MONGODB_DB_NAME=aiblog_generator

# MongoDB Atlas with specific database in URI
# MONGODB_URI=mongodb+srv://username:password@cluster0.abc123.mongodb.net/aiblog_generator?retryWrites=true&w=majority

# Optional: Force custom DNS servers if your ISP blocks mongodb.net
# MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
# MONGODB_DNS_IPV4FIRST=true

# Alternative: Using individual connection parameters (legacy, use MONGODB_URI instead)
# DB_URI=mongodb+srv://username:password@cluster.mongodb.net
# DB_NAME=aiblog_generator

# Shopify OAuth (Partners app)
# Required for "Connect Shopify (OAuth)" button in Settings.
# Redirect URL must be added in your Shopify app settings:
# http://localhost:4319/shopify/callback
SHOPIFY_OAUTH_PORT=4319
# Optional: encryption seed for storing Shopify OAuth secrets in the database.
# If empty, the app derives a key from the local user data path.
APP_ENCRYPTION_KEY=
