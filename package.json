{
  "name": "ai-blog-generator",
  "version": "1.0.0",
  "description": "AI-powered blog generator with OpenAI GPT and DALL-E",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "copy:tinymce": "node scripts/copy-tinymce.js",
    "postinstall": "npm run copy:tinymce",

    "start": "electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --port 5174 --strictPort",
    "dev:electron": "wait-on http://localhost:5174 && electron .",

    "prebuild": "npm run copy:tinymce",
    "build": "vite build --outDir src/renderer/dist",
    "dist": "npm run build && electron-builder",

    "build:win": "npm run build && electron-builder --win",
    "build:exe": "npm run build && electron-builder --win nsis",
    "build:installer": "npm run build && electron-builder --win nsis",
    "build:portable": "npm run build && electron-builder --win portable"
  },
  "keywords": ["blog", "ai", "generator", "openai"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0-rc.12",
    "docx": "^8.5.0",
    "dotenv": "^16.6.1",
    "electron-store": "^8.2.0",
    "form-data": "^4.0.0",
    "markdown-it": "^14.1.0",
    "mime-types": "^2.1.35",
    "mongodb": "^6.21.0",
    "openai": "^4.77.3",
    "puppeteer": "^23.10.1",
    "recharts": "^3.7.0",
    "sql.js": "^1.10.3",
    "tinymce": "^8.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.yourbrand.aibloggen",
    "productName": "AI Blog Generator",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/dist/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Blog Generator",
      "uninstallDisplayName": "AI Blog Generator"
    }
  }
}
